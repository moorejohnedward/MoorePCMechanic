<Project Sdk="Microsoft.NET.Sdk">
  <!-- Smoke test run on GitHub's Windows servers: exercises the driver, benchmark, tune-up and system-check code without the window. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\..\MoorePCMechanic\Services\AppEnv.cs" />
    <Compile Include="..\..\MoorePCMechanic\Services\UpdateService.cs" />
    <Compile Include="..\..\MoorePCMechanic\Services\DriverService.cs" />
    <Compile Include="..\..\MoorePCMechanic\Services\BenchmarkService.cs" />
    <Compile Include="..\..\MoorePCMechanic\Services\GpuBenchmark.cs" />
    <Compile Include="..\..\MoorePCMechanic\Services\Temp.cs" />
    <Compile Include="..\..\MoorePCMechanic\Services\TuneUpService.cs" />
    <Compile Include="..\..\MoorePCMechanic\ViewModels\ObservableBase.cs" />
    <Compile Include="..\..\MoorePCMechanic\Services\SensorService.cs" />
    <Compile Include="..\..\MoorePCMechanic\Services\InventoryService.cs" />
    <Compile Include="..\..\MoorePCMechanic\Services\KnownIssues.cs" />
    <Compile Include="..\..\MoorePCMechanic\Services\SecurityService.cs" />
    <Compile Include="..\..\MoorePCMechanic\Services\SecurityService.System.cs" />
    <Compile Include="..\..\MoorePCMechanic\Services\HardwareCheckService.cs" />
    <Compile Include="..\..\MoorePCMechanic\Services\MemoryTest.cs" />
    <Compile Include="..\..\MoorePCMechanic\Services\StressTest.cs" />
    <PackageReference Include="System.Management" Version="10.0.15" />
    <PackageReference Include="LibreHardwareMonitorLib" Version="0.9.6" />
    <PackageReference Include="Vortice.Direct3D11" Version="3.8.3" />
    <PackageReference Include="Vortice.D3DCompiler" Version="3.8.3" />
  </ItemGroup>
</Project>
