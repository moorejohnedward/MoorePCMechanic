<Window x:Class="MoorePCMechanic.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Moore PC Mechanic"
        Icon="Assets/app.ico"
        Width="1320" Height="880" MinWidth="1000" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBrush}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        FontSize="13"
        Loaded="Window_Loaded"
        Closing="Window_Closing">

    <Window.Resources>

        <!-- Dashboard tile -->
        <DataTemplate x:Key="CardTemplate">
            <Border Style="{StaticResource Panel}" Margin="0,0,12,0">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource IconFont}" FontSize="15"
                                   Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="{Binding Title}" Foreground="{StaticResource MutedBrush}" FontWeight="SemiBold"/>
                    </StackPanel>
                    <TextBlock x:Name="val" Text="{Binding Value}" FontSize="24" FontWeight="SemiBold" Margin="0,8,0,2"/>
                    <TextBlock Text="{Binding Detail}" Foreground="{StaticResource MutedBrush}" FontSize="12" TextTrimming="CharacterEllipsis"/>
                    <ProgressBar Value="{Binding Percent, Mode=OneWay}" Margin="0,12,0,0"/>
                </StackPanel>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Heat}" Value="1">
                    <Setter TargetName="val" Property="Foreground" Value="#FFC24D"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Heat}" Value="2">
                    <Setter TargetName="val" Property="Foreground" Value="{StaticResource WarnBrush}"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- Inventory section -->
        <DataTemplate x:Key="SectionTemplate">
            <Border Style="{StaticResource Panel}" Width="440" Margin="0,0,12,12" VerticalAlignment="Top">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource IconFont}" FontSize="16"
                                   Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,9,0"/>
                        <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold"/>
                    </StackPanel>
                    <ItemsControl ItemsSource="{Binding Items}" Grid.IsSharedSizeScope="True">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" SharedSizeGroup="Label"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Label}" Foreground="{StaticResource MutedBrush}"
                                               MaxWidth="150" TextWrapping="Wrap" Margin="0,0,14,0"/>
                                    <!-- Read-only text box so part numbers etc. can be selected and copied -->
                                    <TextBox Grid.Column="1" Text="{Binding Value, Mode=OneWay}" IsReadOnly="True"
                                             BorderThickness="0" Background="Transparent" Padding="0"
                                             Foreground="{StaticResource TextBrush}" TextWrapping="Wrap"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- Mechanic's note -->
        <DataTemplate x:Key="FindingTemplate">
            <Border x:Name="fb" Background="{StaticResource PanelAltBrush}" CornerRadius="8" BorderThickness="4,0,0,0"
                    BorderBrush="{StaticResource TipBrush}" Padding="12,10" Margin="0,0,0,10">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="lvl" Text="{Binding LevelText}" FontSize="11" FontWeight="Bold"
                                   Foreground="{StaticResource TipBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                    </StackPanel>
                    <TextBlock Text="{Binding Detail}" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,5,0,0"/>
                </StackPanel>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding LevelText}" Value="GOOD">
                    <Setter TargetName="fb" Property="BorderBrush" Value="{StaticResource GoodBrush}"/>
                    <Setter TargetName="lvl" Property="Foreground" Value="{StaticResource GoodBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding LevelText}" Value="CHECK">
                    <Setter TargetName="fb" Property="BorderBrush" Value="{StaticResource WarnBrush}"/>
                    <Setter TargetName="lvl" Property="Foreground" Value="{StaticResource WarnBrush}"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

    </Window.Resources>

    <Grid Margin="20,14,20,10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ================= Header ================= -->
        <Grid Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Image Source="Assets/logo.png" Width="46" Height="46" Margin="0,0,12,0" RenderOptions.BitmapScalingMode="HighQuality"/>
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock FontSize="22" FontWeight="Bold">
                    <Run Text="Moore "/><Run Text="PC" Foreground="{StaticResource AccentBrush}"/><Run Text=" Mechanic"/>
                </TextBlock>
                <TextBlock x:Name="SubtitleText" Foreground="{StaticResource MutedBrush}" Text="Checking your machine…"/>
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="BtnUpdates" Style="{StaticResource GhostButton}" Click="BtnUpdates_Click" Margin="0,0,10,0"
                        ToolTip="See if a newer version of Moore PC Mechanic is available">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE895;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="Check for updates"/>
                    </StackPanel>
                </Button>
                <Border x:Name="AdminPill" CornerRadius="12" Padding="10,4" Margin="0,0,10,0" Background="{StaticResource PanelAltBrush}">
                    <TextBlock x:Name="AdminText" FontSize="12"/>
                </Border>
                <Button x:Name="BtnElevate" Style="{StaticResource AccentButton}" Click="BtnElevate_Click"
                        ToolTip="Temperatures, fan speeds and drive health need administrator rights">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE7EF;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="Restart as admin"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- ================= Update banner (hidden until an update is found) ================= -->
        <Border Grid.Row="1" x:Name="UpdateBanner" Visibility="Collapsed" Margin="0,0,0,12" Padding="14,10"
                CornerRadius="8" Background="{StaticResource PanelAltBrush}"
                BorderBrush="{StaticResource AccentBrush}" BorderThickness="4,0,0,0">
            <DockPanel LastChildFill="True">
                <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Margin="8,0,0,0"
                        Click="BtnDismissUpdate_Click" Content="Not now"/>
                <Button DockPanel.Dock="Right" Style="{StaticResource AccentButton}" Margin="8,0,0,0"
                        Click="BtnShowUpdate_Click" Content="See what's new &amp; update"/>
                <TextBlock Text="&#xE895;" FontFamily="{StaticResource IconFont}" FontSize="16"
                           Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBlock x:Name="UpdateBannerText" VerticalAlignment="Center" TextWrapping="Wrap"
                           Text="A new version of Moore PC Mechanic is ready."/>
            </DockPanel>
        </Border>

        <!-- ================= Tabs ================= -->
        <TabControl Grid.Row="2" x:Name="Tabs">

            <!-- Overview -->
            <TabItem Header="Overview">
                <Grid Margin="0,14,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <ItemsControl x:Name="CardsList" ItemTemplate="{StaticResource CardTemplate}" Margin="0,0,-12,14">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Rows="1"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>

                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,12">
                        <Button x:Name="BtnRescan" Style="{StaticResource AccentButton}" Click="BtnRescan_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE72C;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="Rescan hardware"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource GhostButton}" Click="BtnCopyReport_Click" ToolTip="Copy a full text report - paste it to Claude for upgrade advice">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8C8;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="Copy report"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource GhostButton}" Click="BtnSaveReport_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE74E;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="Save report"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource GhostButton}" Click="BtnOpenData_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE838;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="Open data folder"/>
                            </StackPanel>
                        </Button>
                        <TextBlock x:Name="InvStatus" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                    </StackPanel>

                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="340"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Style="{StaticResource Panel}" Margin="0,0,12,12">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,12">
                                    <TextBlock Text="&#xE90F;" FontFamily="{StaticResource IconFont}" FontSize="16"
                                               Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,9,0"/>
                                    <TextBlock Text="Mechanic's notes" FontSize="15" FontWeight="SemiBold"/>
                                </StackPanel>
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <ItemsControl x:Name="FindingsList" ItemTemplate="{StaticResource FindingTemplate}"/>
                                </ScrollViewer>
                            </DockPanel>
                        </Border>

                        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl x:Name="SectionsList" ItemTemplate="{StaticResource SectionTemplate}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- Audio & calls -->
            <TabItem Header="Audio &amp; calls">
                <Grid Margin="0,14,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="400"/>
                    </Grid.ColumnDefinitions>

                    <!-- ===== Left: headset, devices, event log ===== -->
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="12"/>
                            <RowDefinition Height="200"/>
                        </Grid.RowDefinitions>

                        <Border Style="{StaticResource Panel}" Margin="0,0,0,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <StackPanel Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,0,0,10">
                                    <TextBlock Text="&#xE7F6;" FontFamily="{StaticResource IconFont}" FontSize="16"
                                               Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,9,0"/>
                                    <TextBlock Text="Audio Guard" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    <CheckBox x:Name="GuardCheck" Margin="16,0,0,0" VerticalAlignment="Center"
                                              Foreground="{StaticResource TextBrush}" Click="GuardCheck_Click"
                                              Content="Keep my headset as the speaker and mic"/>
                                    <TextBlock x:Name="GuardStatus" Margin="14,0,0,0" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                </StackPanel>

                                <TextBlock Grid.Row="1" Text="Speaker" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,12,6"/>
                                <ComboBox Grid.Row="1" Grid.Column="1" x:Name="SpeakerPick" Margin="0,0,0,6" MaxWidth="520"
                                          HorizontalAlignment="Left" MinWidth="360" SelectionChanged="DevicePick_Changed"/>
                                <TextBlock Grid.Row="2" Text="Microphone" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,12,6"/>
                                <ComboBox Grid.Row="2" Grid.Column="1" x:Name="MicPick" Margin="0,0,0,6" MaxWidth="520"
                                          HorizontalAlignment="Left" MinWidth="360" SelectionChanged="DevicePick_Changed"/>
                                <StackPanel Grid.Row="3" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,6,0,0">
                                    <CheckBox x:Name="StartupCheck" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"
                                              Click="StartupCheck_Click"
                                              Content="Start with Windows (minimized) so the guard is always on"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Grid.Row="1" Style="{StaticResource Panel}" Padding="0">
                            <DataGrid x:Name="AudioGrid">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Device" Binding="{Binding Name}" Width="*"/>
                                    <DataGridTextColumn Header="Type" Binding="{Binding KindText}" Width="150"/>
                                    <DataGridTextColumn Header="Status" Binding="{Binding StateText}" Width="100"/>
                                    <DataGridTextColumn Header="Default" Binding="{Binding DefaultText}" Width="150"/>
                                    <DataGridTextColumn Header="" Binding="{Binding RoleText}" Width="100" FontWeight="SemiBold"/>
                                    <DataGridTemplateColumn Header="Level" Width="90">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <ProgressBar Value="{Binding Level, Mode=OneWay}" Maximum="1" Height="6" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="" Width="100">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Style="{StaticResource GhostButton}" Padding="10,3" Margin="0,2,6,2" FontSize="12"
                                                        Content="{Binding ToggleText}" Tag="{Binding}" Click="BtnToggleDevice_Click">
                                                    <Button.Visibility>
                                                        <Binding Path="CanToggle">
                                                            <Binding.Converter>
                                                                <BooleanToVisibilityConverter/>
                                                            </Binding.Converter>
                                                        </Binding>
                                                    </Button.Visibility>
                                                </Button>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>

                        <Border Grid.Row="3" Style="{StaticResource Panel}">
                            <DockPanel>
                                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8" LastChildFill="False">
                                    <TextBlock Text="What's happened" FontSize="15" FontWeight="SemiBold" DockPanel.Dock="Left"/>
                                    <TextBlock x:Name="AudioSummary" Foreground="{StaticResource MutedBrush}" Margin="14,2,0,0" DockPanel.Dock="Left"/>
                                    <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Padding="10,3" Margin="0"
                                            Click="BtnOpenLogs_Click" Content="Open log file"/>
                                </DockPanel>
                                <ListBox x:Name="AudioEvents" Background="Transparent" BorderThickness="0"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="92"/>
                                                    <ColumnDefinition Width="60"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding TimeText}" Foreground="{StaticResource MutedBrush}"/>
                                                <TextBlock x:Name="k" Grid.Column="1" Text="{Binding KindText}" FontSize="11" FontWeight="Bold"
                                                           Foreground="{StaticResource TipBrush}" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="2" Text="{Binding Message}" TextWrapping="Wrap" Foreground="{StaticResource TextBrush}"/>
                                            </Grid>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding KindText}" Value="FIXED">
                                                    <Setter TargetName="k" Property="Foreground" Value="{StaticResource GoodBrush}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding KindText}" Value="BACK">
                                                    <Setter TargetName="k" Property="Foreground" Value="{StaticResource GoodBrush}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding KindText}" Value="DROP">
                                                    <Setter TargetName="k" Property="Foreground" Value="{StaticResource WarnBrush}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding KindText}" Value="SWITCH">
                                                    <Setter TargetName="k" Property="Foreground" Value="{StaticResource AccentBrush}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding KindText}" Value="CHECK">
                                                    <Setter TargetName="k" Property="Foreground" Value="{StaticResource WarnBrush}"/>
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </DockPanel>
                        </Border>
                    </Grid>

                    <!-- ===== Right: call-ready check and fixes ===== -->
                    <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <Border Style="{StaticResource Panel}" Margin="0,0,0,12">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                        <TextBlock Text="&#xE714;" FontFamily="{StaticResource IconFont}" FontSize="16"
                                                   Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,9,0"/>
                                        <TextBlock Text="Call-ready check" FontSize="15" FontWeight="SemiBold"/>
                                    </StackPanel>
                                    <TextBlock Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,0,10"
                                               Text="Run this a few minutes before a Zoom class or MOVE session. Talk normally while it runs so it can hear your mic."/>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                        <Button x:Name="BtnCallCheck" Style="{StaticResource AccentButton}" Click="BtnCallCheck_Click" Content="Run check"/>
                                        <Button x:Name="BtnCallFix" Style="{StaticResource GhostButton}" Click="BtnCallFix_Click"
                                                Content="Fix everything" IsEnabled="False"/>
                                    </StackPanel>
                                    <TextBlock x:Name="MicTestLabel" Text="Mic level" Foreground="{StaticResource MutedBrush}" FontSize="12"/>
                                    <ProgressBar x:Name="MicMeter" Maximum="1" Height="10" Margin="0,4,0,12"/>
                                    <ItemsControl x:Name="CallChecks" ItemTemplate="{StaticResource FindingTemplate}"/>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Panel}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                        <TextBlock Text="&#xE90F;" FontFamily="{StaticResource IconFont}" FontSize="16"
                                                   Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,9,0"/>
                                        <TextBlock Text="Fixes for sound cutting out" FontSize="15" FontWeight="SemiBold"/>
                                    </StackPanel>

                                    <TextBlock Text="Windows turning other sound down during calls" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                    <TextBlock Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,2,0,6"
                                               Text="By default Windows lowers everything by 80% when it thinks a call started. That can sound like the audio cutting out."/>
                                    <DockPanel Margin="0,0,0,14">
                                        <Button x:Name="BtnDucking" DockPanel.Dock="Left" Style="{StaticResource GhostButton}" Padding="10,4" Click="BtnDucking_Click"/>
                                        <TextBlock x:Name="DuckingStatus" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                    </DockPanel>

                                    <TextBlock Text="USB power saving" FontWeight="SemiBold"/>
                                    <TextBlock Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,2,0,6"
                                               Text="Windows can cut power to idle USB devices, including your headset's wireless dongle, for a split second."/>
                                    <DockPanel Margin="0,0,0,6">
                                        <Button x:Name="BtnUsbSuspend" DockPanel.Dock="Left" Style="{StaticResource GhostButton}" Padding="10,4" Click="BtnUsbSuspend_Click"/>
                                        <TextBlock x:Name="UsbSuspendStatus" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                    </DockPanel>
                                    <DockPanel Margin="0,0,0,14">
                                        <Button x:Name="BtnUsbPorts" DockPanel.Dock="Left" Style="{StaticResource GhostButton}" Padding="10,4"
                                                Click="BtnUsbPorts_Click" Content="Keep USB ports awake"/>
                                        <TextBlock x:Name="UsbPortsStatus" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                    </DockPanel>

                                    <TextBlock Text="Dongle placement (no app can fix this one)" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                    <TextBlock Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,2,0,6"
                                               Text="If the log shows no DROP lines but you still hear choppy sound, it's the radio signal, not Windows. Use a black USB 2.0 port if you have one (blue USB 3 ports put out 2.4 GHz interference), keep the dongle in front of the case with line of sight to you, and away from the mouse/keyboard receiver and Wi-Fi router. Turn off the headset's Bluetooth during calls."/>
                                    <Button Style="{StaticResource GhostButton}" HorizontalAlignment="Left" Padding="10,4"
                                            Click="BtnSoundPanel_Click" Content="Open Windows Sound settings"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <!-- Live sensors -->
            <TabItem Header="Live sensors">
                <Grid Margin="0,14,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <DockPanel Margin="0,0,0,12" LastChildFill="False">
                        <TextBox x:Name="SensorSearch" Style="{StaticResource SearchBox}" Width="280" DockPanel.Dock="Left"
                                 TextChanged="SensorSearch_TextChanged" ToolTip="Filter by sensor, device or type (e.g. temp, fan, GPU)"/>
                        <TextBlock Text="Filter (try: temp, fan, power, GPU)" Foreground="{StaticResource MutedBrush}"
                                   VerticalAlignment="Center" Margin="10,0,0,0" DockPanel.Dock="Left"/>
                        <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Margin="8,0,0,0" Click="BtnOpenLogs_Click">
                            <TextBlock Text="Open logs folder"/>
                        </Button>
                        <Button x:Name="BtnLog" DockPanel.Dock="Right" Style="{StaticResource AccentButton}" Margin="8,0,0,0" Click="BtnLog_Click"
                                ToolTip="Records every sensor once a second to a CSV file (opens in Excel / Google Sheets)">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE7C8;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock x:Name="BtnLogText" Text="Start logging"/>
                            </StackPanel>
                        </Button>
                        <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Margin="8,0,0,0" Click="BtnResetMinMax_Click">
                            <TextBlock Text="Reset min / max"/>
                        </Button>
                    </DockPanel>

                    <Border Grid.Row="1" Style="{StaticResource Panel}" Padding="0" Margin="0,0,0,8">
                        <DataGrid x:Name="SensorGrid" VirtualizingPanel.IsVirtualizingWhenGrouping="True"
                                  VirtualizingPanel.ScrollUnit="Pixel">
                            <DataGrid.GroupStyle>
                                <GroupStyle>
                                    <GroupStyle.HeaderTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold"
                                                       Foreground="{StaticResource AccentBrush}" Margin="10,12,0,4"/>
                                        </DataTemplate>
                                    </GroupStyle.HeaderTemplate>
                                </GroupStyle>
                            </DataGrid.GroupStyle>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Sensor" Binding="{Binding Name}" Width="*"/>
                                <DataGridTextColumn Header="Type" Binding="{Binding TypeName}" Width="120"/>
                                <DataGridTextColumn Header="Now" Binding="{Binding Value}" Width="130" FontWeight="SemiBold"/>
                                <DataGridTextColumn Header="Min" Binding="{Binding Min}" Width="120"/>
                                <DataGridTextColumn Header="Max" Binding="{Binding Max}" Width="120"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- Processes -->
            <TabItem Header="What's using it">
                <Grid Margin="0,14,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <TextBlock Text="Sort by" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <RadioButton x:Name="SortCpu" Content="CPU" IsChecked="True" Foreground="{StaticResource TextBrush}"
                                     VerticalAlignment="Center" Margin="0,0,14,0" Checked="Sort_Checked"/>
                        <RadioButton x:Name="SortMem" Content="Memory" Foreground="{StaticResource TextBrush}"
                                     VerticalAlignment="Center" Checked="Sort_Checked"/>
                        <TextBlock Text="Programs are grouped (all Chrome windows count as one line). Updates every 2 seconds."
                                   Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="24,0,0,0"/>
                    </StackPanel>
                    <Border Grid.Row="1" Style="{StaticResource Panel}" Padding="0" Margin="0,0,0,8">
                        <DataGrid x:Name="ProcessGrid">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Program" Binding="{Binding Name}" Width="*"/>
                                <DataGridTextColumn Header="Copies" Binding="{Binding CountText}" Width="90"/>
                                <DataGridTextColumn Header="CPU" Binding="{Binding CpuText}" Width="110" FontWeight="SemiBold"/>
                                <DataGridTextColumn Header="Memory" Binding="{Binding MemoryText}" Width="130" FontWeight="SemiBold"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- Drivers -->
            <TabItem Header="Drivers">
                <Grid Margin="0,14,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Toolbar -->
                    <DockPanel Margin="0,0,0,12" LastChildFill="True">
                        <Button x:Name="BtnDrvScan" DockPanel.Dock="Left" Style="{StaticResource AccentButton}" Click="BtnDrvScan_Click"
                                ToolTip="List drivers, find problem devices and ask Windows Update and NVIDIA for newer drivers">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE721;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="Check for driver updates"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="BtnDrvInstall" DockPanel.Dock="Left" Style="{StaticResource AccentButton}" Click="BtnDrvInstall_Click"
                                IsEnabled="False" ToolTip="Makes a restore point, then downloads and installs the ticked updates">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE896;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock x:Name="BtnDrvInstallText" Text="Download &amp; install"/>
                            </StackPanel>
                        </Button>
                        <StackPanel VerticalAlignment="Center" Margin="8,0,0,0">
                            <TextBlock x:Name="DrvStatus" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"
                                       Text="Click &quot;Check for driver updates&quot;. Windows Update can take a minute or two to answer."/>
                            <ProgressBar x:Name="DrvProgress" Margin="0,6,0,0" Visibility="Collapsed" IsIndeterminate="True" MaxWidth="420" HorizontalAlignment="Left"/>
                        </StackPanel>
                    </DockPanel>

                    <!-- NVIDIA + problem devices -->
                    <StackPanel Grid.Row="1">
                        <Border x:Name="NvPanel" Style="{StaticResource Panel}" Margin="0,0,0,12" Visibility="Collapsed">
                            <DockPanel LastChildFill="True">
                                <Button x:Name="BtnNvInstall" DockPanel.Dock="Right" Style="{StaticResource AccentButton}" Margin="12,0,0,0"
                                        Click="BtnNvInstall_Click" VerticalAlignment="Center" Visibility="Collapsed"
                                        ToolTip="Downloads NVIDIA's driver, checks NVIDIA's digital signature, makes a restore point and installs it. Screens flicker for a moment.">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE896;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <TextBlock x:Name="BtnNvInstallText" Text="Download &amp; install"/>
                                    </StackPanel>
                                </Button>
                                <TextBlock Text="&#xE7F4;" FontFamily="{StaticResource IconFont}" FontSize="20" Foreground="{StaticResource GoodBrush}"
                                           VerticalAlignment="Center" Margin="0,0,12,0"/>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock x:Name="NvTitle" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                    <TextBlock x:Name="NvDetail" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                    <ProgressBar x:Name="NvProgress" Margin="0,8,0,0" Visibility="Collapsed" Maximum="1" MaxWidth="420" HorizontalAlignment="Left"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>
                        <ItemsControl x:Name="DrvProblems" ItemTemplate="{StaticResource FindingTemplate}"/>
                    </StackPanel>

                    <!-- Updates (top) and all installed drivers (bottom) -->
                    <Grid Grid.Row="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Border x:Name="WuPanel" Style="{StaticResource Panel}" Padding="0" Margin="0,0,0,12" Visibility="Collapsed" MaxHeight="260">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Top" Margin="14,12,14,6" FontSize="15" FontWeight="SemiBold"
                                           Text="Driver updates from Windows Update (tick the ones to install)"/>
                                <DataGrid x:Name="WuGrid" IsReadOnly="False" CanUserAddRows="False">
                                    <DataGrid.Columns>
                                        <DataGridCheckBoxColumn Header="Install" Binding="{Binding Selected, UpdateSourceTrigger=PropertyChanged}" Width="70"/>
                                        <DataGridTextColumn Header="Update" Binding="{Binding Title}" Width="*" IsReadOnly="True"/>
                                        <DataGridTextColumn Header="Kind" Binding="{Binding ClassName}" Width="130" IsReadOnly="True"/>
                                        <DataGridTextColumn Header="Date" Binding="{Binding DateText}" Width="100" IsReadOnly="True"/>
                                        <DataGridTextColumn Header="Size" Binding="{Binding SizeText}" Width="90" IsReadOnly="True"/>
                                        <DataGridTextColumn Header="Result" Binding="{Binding Result}" Width="190" IsReadOnly="True" FontWeight="SemiBold"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </DockPanel>
                        </Border>
                        <Border Grid.Row="1" Style="{StaticResource Panel}" Padding="0" Margin="0,0,0,8">
                            <DockPanel>
                                <DockPanel DockPanel.Dock="Top" Margin="14,12,14,8" LastChildFill="False">
                                    <TextBlock Text="Installed drivers" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="DrvCount" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                    <CheckBox x:Name="DrvHideMs" DockPanel.Dock="Right" Content="Hide Microsoft's built-in drivers" IsChecked="True"
                                              Foreground="{StaticResource TextBrush}" VerticalAlignment="Center" Margin="12,0,0,0"
                                              Checked="DrvFilter_Changed" Unchecked="DrvFilter_Changed"/>
                                    <TextBox x:Name="DrvSearch" DockPanel.Dock="Right" Style="{StaticResource SearchBox}" Width="220"
                                             TextChanged="DrvFilter_Changed" ToolTip="Filter by device, kind or maker"/>
                                </DockPanel>
                                <DataGrid x:Name="DrvGrid">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Device" Binding="{Binding Device}" Width="*"/>
                                        <DataGridTextColumn Header="Kind" Binding="{Binding ClassName}" Width="140"/>
                                        <DataGridTextColumn Header="Maker" Binding="{Binding Provider}" Width="170"/>
                                        <DataGridTextColumn Header="Version" Binding="{Binding Version}" Width="140"/>
                                        <DataGridTextColumn Header="Date" Binding="{Binding DateText}" Width="100"/>
                                        <DataGridTextColumn Header="Age" Binding="{Binding AgeText}" Width="110"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </DockPanel>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- Benchmarks -->
            <TabItem Header="Benchmarks">
                <Grid Margin="0,14,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Setup -->
                    <Border Style="{StaticResource Panel}" Margin="0,0,0,12">
                        <StackPanel>
                            <WrapPanel>
                                <CheckBox x:Name="BmCpu" Content="Processor" IsChecked="True" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center" Margin="0,0,18,0"/>
                                <CheckBox x:Name="BmMem" Content="Memory" IsChecked="True" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center" Margin="0,0,18,0"/>
                                <CheckBox x:Name="BmGpu" Content="Graphics card" IsChecked="True" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center" Margin="0,0,18,0"/>
                                <CheckBox x:Name="BmDisk" Content="Drive" IsChecked="True" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <ComboBox x:Name="BmDrive" Width="240" VerticalAlignment="Center" Margin="0,0,18,0" DisplayMemberPath="Text"/>
                                <TextBox x:Name="BmLabel" Style="{StaticResource SearchBox}" Width="300" VerticalAlignment="Center" Margin="0,0,12,0"
                                         ToolTip="A name for this run, e.g. &quot;Before RAM upgrade&quot; or &quot;New 5070 Ti&quot;"/>
                                <Button x:Name="BtnBmRun" Style="{StaticResource AccentButton}" Click="BtnBmRun_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE768;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <TextBlock Text="Run benchmarks"/>
                                    </StackPanel>
                                </Button>
                                <Button x:Name="BtnBmStop" Style="{StaticResource GhostButton}" Click="BtnBmStop_Click" Content="Stop" IsEnabled="False"/>
                            </WrapPanel>
                            <TextBlock x:Name="BmStatus" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,10,0,0"
                                       Text="Takes about 1-2 minutes. Close games and big downloads first so they don't skew the numbers. Name the run (box above) so you can find it later."/>
                            <ProgressBar x:Name="BmProgress" Maximum="1" Margin="0,8,0,0" Visibility="Collapsed"/>
                        </StackPanel>
                    </Border>

                    <!-- Results -->
                    <Border Grid.Row="1" Style="{StaticResource Panel}" Margin="0,0,0,12" x:Name="BmResultsPanel" Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock x:Name="BmResultsTitle" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,8" TextWrapping="Wrap"/>
                            <ItemsControl x:Name="BmLines" Grid.IsSharedSizeScope="True">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,3" ToolTip="{Binding Hint}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" SharedSizeGroup="T"/>
                                                <ColumnDefinition Width="Auto" SharedSizeGroup="N"/>
                                                <ColumnDefinition Width="Auto" SharedSizeGroup="B"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Test}" Foreground="{StaticResource MutedBrush}" Margin="0,0,24,0"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Now}" FontWeight="SemiBold" Margin="0,0,24,0"/>
                                            <TextBlock Grid.Column="2" Text="{Binding Before, StringFormat=was {0}}" Foreground="{StaticResource MutedBrush}" Margin="0,0,24,0"/>
                                            <TextBlock Grid.Column="3" x:Name="chg" Text="{Binding Change}" FontWeight="SemiBold"/>
                                        </Grid>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding Better}" Value="1">
                                                <Setter TargetName="chg" Property="Foreground" Value="{StaticResource GoodBrush}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Better}" Value="-1">
                                                <Setter TargetName="chg" Property="Foreground" Value="{StaticResource WarnBrush}"/>
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock x:Name="BmNotes" Foreground="{StaticResource TipBrush}" TextWrapping="Wrap" Margin="0,10,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- History -->
                    <Border Grid.Row="2" Style="{StaticResource Panel}" Padding="0" Margin="0,0,0,8">
                        <DockPanel>
                            <DockPanel DockPanel.Dock="Top" Margin="14,12,14,8" LastChildFill="False">
                                <TextBlock Text="Saved runs" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <TextBlock Text="Pick two runs (Ctrl+click) to compare them, or one to compare with the run before it." Foreground="{StaticResource MutedBrush}"
                                           VerticalAlignment="Center" Margin="12,0,0,0"/>
                                <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Margin="8,0,0,0" Content="Open folder" Click="BtnBmFolder_Click"/>
                                <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Margin="8,0,0,0" Content="Delete" Click="BtnBmDelete_Click"/>
                            </DockPanel>
                            <DataGrid x:Name="BmHistory" SelectionMode="Extended" SelectionChanged="BmHistory_SelectionChanged">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="When" Binding="{Binding DateText}" Width="130"/>
                                    <DataGridTextColumn Header="PC" Binding="{Binding Machine}" Width="140"/>
                                    <DataGridTextColumn Header="Label" Binding="{Binding Label}" Width="*"/>
                                    <DataGridTextColumn Header="CPU 1 core" Binding="{Binding CpuSingleText}" Width="100"/>
                                    <DataGridTextColumn Header="CPU all" Binding="{Binding CpuMultiText}" Width="100"/>
                                    <DataGridTextColumn Header="Memory" Binding="{Binding MemReadText}" Width="110"/>
                                    <DataGridTextColumn Header="Drive read" Binding="{Binding DiskReadText}" Width="110"/>
                                    <DataGridTextColumn Header="Graphics" Binding="{Binding GpuText}" Width="120"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- ================= Status bar ================= -->
        <TextBlock Grid.Row="3" x:Name="StatusText" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="2,6,0,0"/>
    </Grid>
</Window>
