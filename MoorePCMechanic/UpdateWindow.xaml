<Window x:Class="MoorePCMechanic.UpdateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Moore PC Mechanic - Updates"
        Icon="Assets/app.ico"
        Width="580" Height="500" MinWidth="460" MinHeight="380"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="False"
        Background="{StaticResource BgBrush}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        FontSize="13">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal">
            <TextBlock Text="&#xE895;" FontFamily="{StaticResource IconFont}" FontSize="20"
                       Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <TextBlock x:Name="HeadlineText" FontSize="20" FontWeight="SemiBold" Text="Checking for updates…"/>
        </StackPanel>
        <TextBlock x:Name="VersionText" Grid.Row="1" Margin="0,6,0,14" Foreground="{StaticResource MutedBrush}"/>

        <Border Grid.Row="2" Style="{StaticResource Panel}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <TextBlock x:Name="NotesText" TextWrapping="Wrap" LineHeight="20"/>
            </ScrollViewer>
        </Border>

        <StackPanel Grid.Row="3" Margin="0,14,0,0">
            <ProgressBar x:Name="DownloadProgress" Height="8" Minimum="0" Maximum="1" Visibility="Collapsed"/>
            <TextBlock x:Name="StatusText" Margin="0,6,0,0" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}"/>
        </StackPanel>

        <DockPanel Grid.Row="4" Margin="0,12,0,0" LastChildFill="False">
            <CheckBox x:Name="AutoCheckBox" DockPanel.Dock="Left" VerticalAlignment="Center"
                      Foreground="{StaticResource TextBrush}"
                      Content="Check for updates when the app starts"/>
            <Button x:Name="UpdateButton" DockPanel.Dock="Right" Style="{StaticResource AccentButton}" Margin="0"
                    IsDefault="True" Content="Update now" Click="UpdateButton_Click"/>
            <Button x:Name="LaterButton" DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Margin="0,0,8,0"
                    IsCancel="True" Content="Later" Click="LaterButton_Click"/>
            <Button x:Name="SkipButton" DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Margin="0,0,8,0"
                    Content="Skip this version" Click="SkipButton_Click"/>
        </DockPanel>
    </Grid>
</Window>
